# Chave de API gratuita gerada em https://aistudio.google.com
GEMINI_API_KEY=

# Modelo Gemini usado pelo orquestrador e pelos agentes. O desafio pede
# "gemini-2.0-flash", mas o Google descontinua modelos Gemini periodicamente —
# se a API retornar 404 para o modelo configurado, liste os disponíveis para
# sua chave e troque por um "flash"/"flash-lite" equivalente.
GEMINI_MODEL=gemini-3.5-flash-lite

# Modelo de embedding local (sentence-transformers) — roda offline, não consome quota de API
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Host/porta do container do ChromaDB (nome do serviço no docker-compose)
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# String de conexão SQLite assíncrona (SQLAlchemy + aiosqlite)
DATABASE_URL=sqlite+aiosqlite:///./data/threads.db

# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
